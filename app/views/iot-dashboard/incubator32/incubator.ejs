<%- include('../../partials/header') %>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/socket.io/socket.io.js"></script>

    <div id="data-container"
        data-device-id="<%= device_data.device_id %>"
        data-role="<%= role %>"
        data-chart-labels='<%- JSON.stringify(chart_labels) %>'
        data-chart-temp-avg='<%- JSON.stringify(chart_temp_avg) %>'
        data-chart-temp-high='<%- JSON.stringify(chart_temp_high) %>'
        data-chart-temp-low='<%- JSON.stringify(chart_temp_low) %>'
        data-chart-hum-avg='<%- JSON.stringify(chart_hum_avg) %>'
        data-chart-hum-high='<%- JSON.stringify(chart_hum_high) %>'
        data-chart-hum-low='<%- JSON.stringify(chart_hum_low) %>' style="display:none">
    </div>

    <script>
        const container = document.getElementById('data-container');
        const deviceId = container.dataset.deviceId;

        const batchPresets = {
            chicken: { temp: 37.5, hum: 55, infoTemp: "Optimal: 37.2°C - 37.8°C", infoHum: "Optimal: 55% - 60%" },
            duck: { temp: 37.8, hum: 60, infoTemp: "Optimal: 37.5°C - 38.0°C", infoHum: "Optimal: 60% - 65%" },
            quail: { temp: 37.7, hum: 50, infoTemp: "Optimal: 37.5°C - 37.8°C", infoHum: "Optimal: 45% - 55%" }
        };
    </script>

    <style>
        /* Custom Batch Dropdown */
        .batch-dropdown {
            position: relative;
        }

        .batch-dropdown-menu {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            min-width: 100%;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
            overflow: hidden;
            z-index: 100;
            opacity: 0;
            transform: translateY(-8px) scale(0.97);
            pointer-events: none;
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        .batch-dropdown-menu.open {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: auto;
        }

        .batch-dropdown-menu button {
            display: block;
            width: 100%;
            text-align: left;
            padding: 10px 18px;
            font-size: 0.8rem;
            font-weight: 600;
            color: #333;
            background: transparent;
            border: none;
            cursor: pointer;
            transition: background 0.15s ease;
            white-space: nowrap;
        }

        .batch-dropdown-menu button:hover {
            background: #f3ede5;
        }

        .batch-dropdown-menu button.active {
            background: #C69C6D;
            color: #fff;
        }

        @media (min-width: 640px) {
            .batch-dropdown-menu {
                left: auto;
                right: 0;
            }
        }

        .mode-btn {
            transition: all 0.2s ease;
        }
        .mode-btn.active {
            background: #C69C6D;
            color: #000;
            border-color: #C69C6D;
        }
    </style>


    <%- include('../../partials/sidebar') %>

    <div class="lg:pl-64">
    <div class="max-w-5xl mx-auto w-full px-4 sm:px-6 pt-20 sm:pt-24 lg:pt-10">
        <header
            class="flex flex-col md:flex-row justify-between items-start md:items-end mb-6 sm:mb-12 gap-4 sm:gap-6 border-b border-gray-300 pb-4 sm:pb-8">
            <div>
                <h1 class="text-2xl sm:text-4xl md:text-5xl font-bold text-black leading-tight"><%= device_data.device_name %></h1>
                <p class="mt-1 mb-1 sm:mb-2 font-mono text-[10px] sm:text-xs font-medium text-gray-500"><%= device_data.device_id %></p>
                <p id="status" class="mt-2 text-xs sm:text-sm font-medium text-orange-600">Status: Connecting...</p>
            </div>
            <div class="flex flex-col items-start md:items-end mt-2 md:mt-0">
                <p class="text-xs font-bold uppercase mb-2">BATCH TYPE</p>
                <!-- Hidden native select for changeBatchType() compatibility -->
                <select id="batch-select" onchange="changeBatchType()" class="hidden">
                    <option value="chicken">Chicken (Ayam)</option>
                    <option value="duck">Duck (Bebek)</option>
                    <option value="quail">Quail (Puyuh)</option>
                </select>
                <!-- Custom Dropdown -->
                <div class="batch-dropdown" id="batch-dropdown">
                    <button onclick="toggleBatchDropdown(event)" id="batch-dropdown-btn"
                        class="bg-[#C69C6D] text-black font-semibold px-5 py-2 rounded-full shadow-sm text-xs sm:text-sm flex items-center gap-2 hover:bg-[#b8885a] transition-colors duration-200">
                        <span id="batch-dropdown-label">Chicken (Ayam)</span>
                        <svg id="batch-dropdown-arrow" class="w-3.5 h-3.5 transition-transform duration-200" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                    <div class="batch-dropdown-menu" id="batch-dropdown-menu">
                        <button onclick="selectBatch('chicken', 'Chicken (Ayam)')" class="active">Chicken
                            (Ayam)</button>
                        <button onclick="selectBatch('duck', 'Duck (Bebek)')">Duck (Bebek)</button>
                        <button onclick="selectBatch('quail', 'Quail (Puyuh)')">Quail (Puyuh)</button>
                    </div>
                </div>
            </div>
        </header>

        <div class="grid grid-cols-2 gap-3 sm:gap-8 md:gap-12">
            <div
                class="bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-8 shadow-[10px_10px_20px_rgba(0,0,0,0.05)] border border-white flex flex-col justify-between hover:shadow-2xl hover:-translate-y-1 hover:border-gray-100 transition-all duration-300">
                <div
                    class="flex items-center gap-1.5 sm:gap-3 mb-3 sm:mb-6 font-bold uppercase tracking-wide text-[11px] sm:text-base">
                    <svg class="w-4 h-4 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        stroke-width="2">
                        <path d="M12 3v13.5m0 0a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7z"></path>
                    </svg>
                    <h2>TEMPERATURE</h2>
                </div>
                <div class="text-3xl sm:text-[3.5rem] font-bold text-[#386628] mb-3 sm:mb-8 leading-none"><span
                        id="suhu">--</span>°C</div>
                <div class="border border-black rounded-lg sm:rounded-xl p-2.5 sm:p-4">
                    <div class="flex justify-between items-center">
                        <div>
                            <p class="text-[8px] sm:text-[0.65rem] font-bold uppercase mb-0.5 sm:mb-1">TARGET</p>
                            <p id="target-temp" class="text-sm sm:text-xl font-bold">37.5 °C</p>
                        </div>
                        <div class="flex gap-1.5 sm:gap-2">
                            <button onclick="updateTarget('temp', -0.1)"
                                class="w-6 h-6 sm:w-8 sm:h-8 rounded bg-[#386628] text-white flex items-center justify-center font-bold text-sm">-</button>
                            <button onclick="updateTarget('temp', 0.1)"
                                class="w-6 h-6 sm:w-8 sm:h-8 rounded bg-[#386628] text-white flex items-center justify-center font-bold text-sm">+</button>
                        </div>
                    </div>
                    <div class="h-px bg-gray-200 my-1.5 sm:my-2 hidden sm:block"></div>
                    <p id="info-optimal-temp" class="text-[0.60rem] sm:text-[0.65rem] font-semibold hidden sm:block">
                        Optimal: 37.2°C - 37.8°C</p>
                </div>
            </div>

            <div
                class="bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-8 shadow-[10px_10px_20px_rgba(0,0,0,0.05)] border border-white flex flex-col justify-between hover:shadow-2xl hover:-translate-y-1 hover:border-gray-100 transition-all duration-300">
                <div
                    class="flex items-center gap-1.5 sm:gap-3 mb-3 sm:mb-6 font-bold uppercase tracking-wide text-[11px] sm:text-base">
                    <svg class="w-4 h-4 sm:w-6 sm:h-6" fill="currentColor" viewBox="0 0 24 24">
                        <path
                            d="M12 2.25c-5.385 5.965-8.25 10.975-8.25 14.25a8.25 8.25 0 0016.5 0c0-3.275-2.865-8.285-8.25-14.25z" />
                    </svg>
                    <h2>HUMIDITY</h2>
                </div>
                <div class="text-3xl sm:text-[3.5rem] font-bold text-[#1E88E5] mb-3 sm:mb-8 leading-none"><span
                        id="kelembapan">--</span>%</div>
                <div class="border border-black rounded-lg sm:rounded-xl p-2.5 sm:p-4">
                    <div class="flex justify-between items-center">
                        <div>
                            <p class="text-[8px] sm:text-[0.65rem] font-bold uppercase mb-0.5 sm:mb-1">TARGET</p>
                            <p id="target-hum" class="text-sm sm:text-xl font-bold">55%</p>
                        </div>
                        <div class="flex gap-1.5 sm:gap-2">
                            <button onclick="updateTarget('hum', -1)"
                                class="w-6 h-6 sm:w-8 sm:h-8 rounded bg-[#1E88E5] text-white flex items-center justify-center font-bold text-sm">-</button>
                            <button onclick="updateTarget('hum', 1)"
                                class="w-6 h-6 sm:w-8 sm:h-8 rounded bg-[#1E88E5] text-white flex items-center justify-center font-bold text-sm">+</button>
                        </div>
                    </div>
                    <div class="h-px bg-gray-200 my-1.5 sm:my-2 hidden sm:block"></div>
                    <p id="info-optimal-hum" class="text-[0.60rem] sm:text-[0.65rem] font-semibold hidden sm:block">
                        Optimal: 55%-60%</p>
                </div>
            </div>

            <!-- KARTU GABUNGAN FAN SPEED + SERVO (bisa dibuka/ditutup) -->
            <div
                class="col-span-2 bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-8 shadow-[10px_10px_20px_rgba(0,0,0,0.05)] border border-white hover:shadow-2xl hover:-translate-y-1 hover:border-gray-100 transition-all duration-300">
                <!-- Header: klik untuk buka/tutup -->
                <button type="button" onclick="toggleFanServo()"
                    class="w-full flex items-center justify-between gap-3 mb-3 sm:mb-4 cursor-pointer select-none">
                    <span
                        class="flex items-center gap-1.5 sm:gap-3 font-bold uppercase tracking-wide text-[11px] sm:text-base text-left">
                        <span class="flex items-center gap-0.5 sm:gap-1">
                            <!-- Ikon kipas (Fan Speed) -->
                            <svg class="w-4 h-4 sm:w-6 sm:h-6" viewBox="0 0 24 24" fill="currentColor">
                                <ellipse cx="12" cy="6.8" rx="2.3" ry="4.3" />
                                <ellipse cx="12" cy="6.8" rx="2.3" ry="4.3" transform="rotate(120 12 12)" />
                                <ellipse cx="12" cy="6.8" rx="2.3" ry="4.3" transform="rotate(240 12 12)" />
                                <circle cx="12" cy="12" r="1.7" />
                            </svg>
                            <!-- Ikon gear (Servo) -->
                            <svg class="w-4 h-4 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </span>
                        <h2>FAN SPEED &amp; SERVO</h2>
                        <span
                            class="hidden lg:inline-flex items-center gap-2 normal-case tracking-normal font-semibold text-xs text-gray-400 ml-1">
                            <span id="fs-summary-fan" class="font-bold text-gray-800">--%</span>
                            <span class="text-gray-300">|</span>
                            Mode: <span id="fs-summary-mode" class="font-bold text-gray-800">--</span>
                        </span>
                    </span>
                    <svg id="fan-servo-arrow" class="w-5 h-5 text-gray-500 shrink-0 transition-transform duration-200" fill="none"
                        stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                <!-- Konten: tersembunyi saat halaman dimuat, buka lewat header -->
                <div id="fan-servo-content" class="hidden grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-8">
                    <!-- Fan Speed -->
                    <div>
                        <p class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-2">
                            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
                                <ellipse cx="12" cy="6.8" rx="2.3" ry="4.3" />
                                <ellipse cx="12" cy="6.8" rx="2.3" ry="4.3" transform="rotate(120 12 12)" />
                                <ellipse cx="12" cy="6.8" rx="2.3" ry="4.3" transform="rotate(240 12 12)" />
                                <circle cx="12" cy="12" r="1.7" />
                            </svg>
                            Fan Speed
                        </p>
                        <div class="border border-black rounded-lg sm:rounded-xl p-2.5 sm:p-4">
                            <div class="flex justify-between items-center">
                                <div>
                                    <p class="text-[8px] sm:text-[0.65rem] font-bold uppercase mb-0.5 sm:mb-1">TARGET</p>
                                    <p id="target-fan" class="text-sm sm:text-xl font-bold">--%</p>
                                </div>
                                <div class="flex gap-1.5 sm:gap-2">
                                    <button onclick="updateTarget('fan', -5)"
                                        class="w-6 h-6 sm:w-8 sm:h-8 rounded bg-[#386628] text-white flex items-center justify-center font-bold text-sm">-</button>
                                    <button onclick="updateTarget('fan', 5)"
                                        class="w-6 h-6 sm:w-8 sm:h-8 rounded bg-[#386628] text-white flex items-center justify-center font-bold text-sm">+</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Servo -->
                    <div>
                        <p class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-2">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            Servo Pembalik Telur
                        </p>
                        <div class="flex gap-2 mb-3">
                            <button id="mode-jadwal" onclick="setServoMode(0)"
                                class="mode-btn flex-1 border-2 border-gray-200 rounded-xl p-2 sm:p-3 text-center cursor-pointer hover:border-gray-300">
                                <div class="font-bold text-xs sm:text-sm">JADWAL</div>
                            </button>
                            <button id="mode-swing" onclick="setServoMode(1)"
                                class="mode-btn flex-1 border-2 border-gray-200 rounded-xl p-2 sm:p-3 text-center cursor-pointer hover:border-gray-300">
                                <div class="font-bold text-xs sm:text-sm">SWING</div>
                            </button>
                        </div>
                        <div class="text-[10px] sm:text-xs text-gray-500 text-center mb-2">
                            Mode: <span id="current-mode-text" class="font-bold text-gray-800">--</span>
                        </div>
                        <div id="servo-interval-section" class="hidden border-t border-gray-100 pt-3">
                            <div class="flex items-center justify-center gap-2 sm:gap-3 mb-2">
                                <button onclick="changeInterval(-1)"
                                    class="w-6 h-6 sm:w-7 sm:h-7 rounded bg-[#386628] text-white flex items-center justify-center font-bold text-xs sm:text-sm">-</button>
                                <div class="text-center">
                                    <span id="interval-value" class="text-lg sm:text-xl font-bold text-gray-800">--</span>
                                    <span class="text-xs sm:text-sm font-bold text-gray-500 ml-0.5">jam</span>
                                </div>
                                <button onclick="changeInterval(1)"
                                    class="w-6 h-6 sm:w-7 sm:h-7 rounded bg-[#386628] text-white flex items-center justify-center font-bold text-xs sm:text-sm">+</button>
                            </div>
                            <div class="flex items-center justify-center gap-3">
                                <button onclick="applyInterval()"
                                    class="bg-black text-white font-semibold px-3 py-1 rounded-full text-[10px] sm:text-xs hover:bg-gray-800 transition-colors">
                                    Terapkan
                                </button>
                                <span class="text-[10px] sm:text-xs text-gray-500">
                                    <span id="current-interval-text" class="font-bold text-gray-800">--</span> jam
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CAMERA MONITORING WIDGET (ESP32-S3 CAM) -->
        <div class="mt-6 sm:mt-12 bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-8 shadow-[10px_10px_20px_rgba(0,0,0,0.05)] border border-gray-100 hover:shadow-2xl transition-all duration-300">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 pb-4 border-b border-gray-100">
                <div class="flex items-center gap-3">
                    <div class="p-2.5 bg-cream-bg text-accent-brown rounded-2xl">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="flex items-center gap-2 flex-wrap">
                            <h2 class="text-base sm:text-lg font-bold text-gray-900 uppercase tracking-tight">Kamera Pemantau Telur</h2>
                        </div>
                        <div class="flex items-center gap-2 mt-1">
                            <span id="inc-cam-status-dot" class="w-2 h-2 rounded-full bg-gray-400 shrink-0"></span>
                            <p id="inc-cam-status" class="text-xs text-gray-500 truncate">
                                Memeriksa koneksi kamera...
                            </p>
                            <button type="button" onclick="pingCameraNow()" class="text-gray-400 hover:text-accent-brown p-0.5 rounded transition-colors" title="Cek ulang status kamera">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2 w-full sm:w-auto flex-wrap sm:flex-nowrap">
                    <!-- Tombol Settings Kamera (menu: sandingkan / lepas / info) -->
                    <div class="relative" id="cam-settings-wrap">
                        <button type="button" onclick="toggleCamSettings(event)" class="p-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 border border-gray-200 transition-colors flex items-center justify-center" title="Pengaturan Kamera">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </button>
                        <div id="cam-settings-menu" class="hidden absolute right-0 top-full mt-2 w-60 bg-white rounded-2xl shadow-[0_8px_30px_rgba(0,0,0,0.12)] border border-gray-100 overflow-hidden z-40">
                            <button type="button" onclick="openCamPairModal(); closeCamSettings();"
                                class="w-full text-left px-4 py-3 text-xs font-semibold text-gray-700 hover:bg-cream-bg hover:text-accent-brown transition-colors flex items-center gap-2.5">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                                <span id="btn-pair-label"><%= device_data.camera_mac ? 'Ganti Sandingan' : 'Sandingkan Kamera' %></span>
                            </button>
                            <button id="btn-unpair-cam" type="button" onclick="unpairCamera(); closeCamSettings();"
                                class="<%= device_data.camera_mac ? '' : 'hidden' %> w-full text-left px-4 py-3 text-xs font-semibold text-red-600 hover:bg-red-50 border-t border-gray-100 transition-colors flex items-center gap-2.5">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                Lepas Sandingan
                            </button>
                            <button type="button" onclick="openCamInfoModal(); closeCamSettings();"
                                class="w-full text-left px-4 py-3 text-xs font-semibold text-gray-700 hover:bg-cream-bg hover:text-accent-brown border-t border-gray-100 transition-colors flex items-center gap-2.5">
                                <svg class="w-3.5 h-3.5 text-accent-brown" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                Info Modul
                            </button>
                        </div>
                    </div>
                    <button id="btn-inc-capture" onclick="triggerIncubatorCameraCapture()" class="flex-1 sm:flex-initial bg-[#C69C6D] hover:bg-[#b8885a] active:scale-95 text-black font-bold px-4 py-2 sm:px-5 sm:py-2.5 rounded-xl shadow-md shadow-batch-brown/30 text-xs sm:text-sm transition-all flex items-center justify-center gap-2">
                        <svg id="inc-icon-cam" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <svg id="inc-icon-loading" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                        </svg>
                        <span id="inc-btn-capture-text">Ambil Foto Sekarang</span>
                    </button>
                </div>
            </div>

            <!-- Grid Konten Kamera -->
            <% 
                const _latestCam = (typeof latestCamPhoto !== 'undefined' && latestCamPhoto) ? latestCamPhoto : null; 
                const _recentPhotos = (typeof recentCamPhotos !== 'undefined' && Array.isArray(recentCamPhotos)) ? recentCamPhotos : []; 
            %>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
                <!-- Foto Utama (2 Kolom) -->
                <div class="md:col-span-2 relative aspect-[16/10] bg-gray-900 rounded-2xl overflow-hidden flex items-center justify-center border border-gray-200 group">
                    <img id="inc-latest-photo" 
                         src="<%= _latestCam ? _latestCam.filepath : '' %>" 
                         alt="Kondisi Telur Inkubator" 
                         class="w-full h-full object-contain <%= _latestCam ? '' : 'hidden' %> cursor-pointer transition-transform duration-300 group-hover:scale-[1.02]"
                         onclick="openIncPhotoModal(this.src, document.getElementById('inc-photo-time').innerText, '<%= _latestCam ? _latestCam.id : '' %>')">
                    
                    <div id="inc-no-photo" class="flex flex-col items-center justify-center p-6 text-center text-gray-400 <%= _latestCam ? 'hidden' : '' %>">
                        <svg class="w-12 h-12 mb-2 text-gray-600 stroke-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                        </svg>
                        <p class="font-bold text-sm text-gray-300">Belum Ada Foto Terambil</p>
                        <p class="text-xs text-gray-500 mt-1">Tekan tombol "Ambil Foto Sekarang" untuk meminta modul ESP32-S3 Cam memotret telur di dalam inkubator.</p>
                    </div>

                    <!-- Flash overlay -->
                    <div id="inc-capture-flash" class="absolute inset-0 bg-white opacity-0 pointer-events-none transition-opacity duration-200"></div>

                    <!-- Info bar overlay -->
                    <div class="absolute bottom-2 left-2 right-2 flex justify-between items-center bg-black/60 backdrop-blur-sm text-white px-3 py-1.5 rounded-lg text-[10px] sm:text-xs">
                        <span id="inc-photo-time" class="font-mono truncate">
                            <%= _latestCam ? new Date(_latestCam.captured_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'medium' }) : 'Menunggu pemotretan pertama...' %>
                        </span>
                        <div class="flex items-center gap-2">
                            <span class="text-accent-brown font-semibold shrink-0">Live Capture</span>
                            <% if (_latestCam) { %>
                            <button onclick="event.stopPropagation(); deleteIncPhoto(<%= _latestCam.id %>)" class="text-gray-400 hover:text-red-400 p-0.5" title="Hapus Foto">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Mini Galeri Riwayat Foto (1 Kolom) -->
                <div class="flex flex-col gap-2.5">
                    <div class="flex items-center justify-between">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500">Riwayat Foto Telur</h3>
                        <span id="inc-photos-count" class="text-[11px] font-semibold text-accent-brown bg-cream-bg px-2 py-0.5 rounded-full border border-accent-brown/20"><%= _recentPhotos.length %> Foto</span>
                    </div>
                    <div id="inc-recent-grid" class="grid grid-cols-3 gap-2 max-h-56 overflow-y-auto p-1">
                        <% if (_recentPhotos && _recentPhotos.length > 0) { %>
                            <% _recentPhotos.forEach(p => { %>
                                <div id="inc-thumb-<%= p.id %>" class="group relative aspect-square rounded-xl overflow-hidden bg-gray-100 border border-gray-200 cursor-pointer hover:opacity-90 transition-opacity" onclick="openIncPhotoModal('<%= p.filepath %>', '<%= p.captured_at %>', <%= p.id %>)">
                                    <img src="<%= p.filepath %>" alt="<%= p.filename %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200" loading="lazy">
                                    <button onclick="event.stopPropagation(); deleteIncPhoto(<%= p.id %>)" class="absolute top-1 right-1 bg-black/60 hover:bg-red-600 text-white rounded-md p-1 opacity-0 group-hover:opacity-100 transition-opacity" title="Hapus">
                                        <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                    </button>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div id="inc-empty-thumbs" class="col-span-3 py-6 text-center text-[11px] text-gray-400 border border-dashed rounded-xl">
                                Belum ada riwayat foto
                            </div>
                        <% } %>
                    </div>
                    <p id="inc-capture-msg" class="text-[11px] text-gray-500 mt-1 italic">
                        ESP32-S3 Cam memotret kondisi telur saat tombol ditekan dan menyimpannya di sini.
                    </p>
                </div>
            </div>

            <!-- HASIL ANALISIS FERTILITAS TELUR -->
            <div id="inc-fertility-panel" class="mt-6 rounded-2xl border border-gray-200 bg-gray-50 p-4 sm:p-5 hidden">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-tight">Hasil Analisis Fertilitas</h3>
                        <p id="inc-fertility-status" class="text-xs text-gray-500 mt-0.5">Belum dianalisis</p>
                    </div>
                    <a id="inc-fertility-annotated-link" href="#" target="_blank" rel="noopener"
                        class="hidden text-xs font-semibold text-accent-brown hover:underline">
                        Lihat gambar anotasi
                    </a>
                </div>
                <div id="inc-fertility-stats" class="mt-4 grid grid-cols-3 gap-2 sm:gap-3 hidden">
                    <div class="rounded-xl bg-white border border-gray-200 p-3 text-center">
                        <div class="text-[10px] font-semibold uppercase tracking-wider text-gray-500">Fertile</div>
                        <div id="inc-fertility-fertile" class="text-xl font-bold text-emerald-600">-</div>
                    </div>
                    <div class="rounded-xl bg-white border border-gray-200 p-3 text-center">
                        <div class="text-[10px] font-semibold uppercase tracking-wider text-gray-500">Infertile</div>
                        <div id="inc-fertility-infertile" class="text-xl font-bold text-red-500">-</div>
                    </div>
                    <div class="rounded-xl bg-white border border-gray-200 p-3 text-center">
                        <div class="text-[10px] font-semibold uppercase tracking-wider text-gray-500">Fertility Rate</div>
                        <div id="inc-fertility-rate" class="text-xl font-bold text-accent-brown">-</div>
                    </div>
                </div>
                <p id="inc-fertility-detail" class="mt-3 text-[11px] text-gray-500 italic hidden"></p>
            </div>
        </div>

        <!-- MODAL SANDINGKAN KAMERA (PAIRING) -->
        <div id="cam-pair-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
            <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl border border-gray-100 relative">
                <button onclick="closeCamPairModal()" class="absolute top-5 right-5 text-gray-400 hover:text-gray-700 p-1 rounded-full hover:bg-gray-100 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>

                <div class="flex items-center gap-3 mb-4">
                    <div class="p-2.5 bg-cream-bg text-accent-brown rounded-2xl">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-gray-900">Sandingkan ESP32-S3 CAM</h3>
                        <p class="text-xs text-gray-500">Penyandingan otomatis berbasis MAC Address Hardware</p>
                    </div>
                </div>

                <form onsubmit="submitCameraPair(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                            ID Kamera / MAC Address Hardware
                        </label>
                        <input type="text" id="input-cam-mac" required
                               value="<%= device_data.camera_mac || '' %>"
                               placeholder="Contoh: cam-d4e5f6 atau e8:6b:ea:d4:e5:f6"
                               class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm font-mono focus:outline-none focus:ring-2 focus:ring-accent-brown focus:bg-white transition-all">
                        <p class="text-[11px] text-gray-500 mt-2 leading-relaxed">
                            💡 <b>Cara melihat ID Kamera:</b> Nyalakan modul ESP32-S3 CAM dan buka <i>Serial Monitor Arduino (115200 baud)</i>. ID bawaan kamera Anda (misal <code class="bg-gray-100 text-accent-brown px-1 rounded font-bold">cam-xxxxxx</code>) akan tercetak saat booting.
                        </p>
                    </div>

                    <div class="p-3 bg-cream-bg rounded-xl border border-accent-brown/20 text-xs text-dark-text">
                        <p class="font-semibold mb-1">Keuntungan Pairing MAC:</p>
                        <p class="text-[11px] text-gray-600">
                            Firmware kamera tidak perlu di-flash ulang saat dipindahkan antar-inkubator. Cukup masukkan ID kamera di sini, kamera otomatis terhubung ke inkubator ini!
                        </p>
                    </div>

                    <div class="flex items-center gap-3 pt-2">
                        <button type="button" onclick="closeCamPairModal()" class="flex-1 py-2.5 px-4 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold rounded-xl text-xs transition-colors">
                            Batal
                        </button>
                        <button type="submit" id="btn-submit-pair" class="flex-1 py-2.5 px-4 bg-[#C69C6D] hover:bg-[#b8885a] text-black font-bold rounded-xl text-xs shadow-md shadow-batch-brown/30 transition-all flex items-center justify-center gap-1.5">
                            Simpan & Sandingkan
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- MODAL INFO & PANDUAN MODUL ESP32-S3 CAM UNTUK INKUBATOR INI -->
        <div id="cam-info-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
            <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-gray-100 relative max-h-[90vh] overflow-y-auto">
                <button onclick="closeCamInfoModal()" class="absolute top-5 right-5 text-gray-400 hover:text-gray-700 p-1 rounded-full hover:bg-gray-100 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>

                <div class="flex items-center gap-3 mb-4">
                    <div class="p-2.5 bg-cream-bg text-accent-brown rounded-2xl">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path></svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-gray-900">Modul Kamera ESP32-S3</h3>
                        <p class="text-xs text-gray-500">Konfigurasi perangkat kamera untuk <%= device_data.device_name %></p>
                    </div>
                </div>

                <p class="text-xs text-gray-600 mb-3 leading-relaxed">
                    Kamera terhubung langsung ke inkubator ini berdasarkan ID MAC hardware tanpa perlu dashboard terpisah.
                </p>

                <div class="bg-gray-900 text-green-400 font-mono text-xs rounded-2xl p-4 mb-4 relative overflow-x-auto select-all">
                    <p><span class="text-accent-brown">// Identitas Perangkat:</span></p>
                    <p>Inkubator ID : <span class="text-yellow-300 font-bold"><%= device_data.device_id %></span></p>
                    <p>Camera ID    : <span id="modal-info-mac" class="text-yellow-300 font-bold"><%= device_data.camera_mac || '(Belum disandingkan)' %></span></p>
                    <p class="mt-2"><span class="text-accent-brown">// Broker MQTT:</span></p>
                    <p>Server : "<span class="text-yellow-300"><%= device_data.broker_url %></span>"</p>
                    <p>Port   : 1883</p>
                    <p class="mt-2"><span class="text-accent-brown">// Topik MQTT Kamera:</span></p>
                    <p><span class="text-gray-400">Subscribe (Perintah) :</span> camera/<span class="text-yellow-300 font-bold" id="modal-info-topic-sub"><%= device_data.camera_mac || '<ID_KAMERA>' %></span>/con</p>
                    <p><span class="text-gray-400">Publish (Status)     :</span> camera/<span class="text-yellow-300 font-bold" id="modal-info-topic-pub"><%= device_data.camera_mac || '<ID_KAMERA>' %></span>/data</p>
                    <p class="mt-2"><span class="text-accent-brown">// Upload Foto via HTTP POST:</span></p>
                    <p class="text-gray-300">/api/devices/<%= device_data.device_id %>/camera/upload</p>
                </div>

                <div class="bg-cream-bg rounded-2xl p-4 border border-accent-brown/20 text-xs text-dark-text mb-5">
                    <p class="font-bold mb-1">Alur Kerja Otomatis:</p>
                    <ol class="list-decimal ml-4 space-y-1 text-gray-600">
                        <li>Pastikan kamera sudah disandingkan dengan menekan tombol <b>"Sandingkan Kamera"</b>.</li>
                        <li>Klik <b>"Ambil Foto Sekarang"</b> di widget ini.</li>
                        <li>Dashboard mengirim sinyal capture ke kamera via MQTT (<code class="bg-white text-accent-brown px-1 rounded font-bold">camera/&lt;id&gt;/con</code>).</li>
                        <li>ESP32-S3 mengambil foto dan mengunggahnya ke server.</li>
                        <li>Foto langsung tampil di galeri ini secara realtime tanpa reload!</li>
                    </ol>
                </div>

                <button type="button" onclick="closeCamInfoModal()" class="w-full bg-gray-900 hover:bg-black text-white font-bold py-3 rounded-xl text-xs transition-colors">
                    Mengerti & Tutup
                </button>
            </div>
        </div>

        <!-- MODAL PREVIEW FOTO BESAR -->
        <div id="inc-photo-modal" class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex flex-col items-center justify-center p-4">
            <div class="absolute top-4 right-4 flex items-center gap-3">
                <a id="inc-modal-download" href="#" download class="p-2.5 bg-white/10 hover:bg-white/20 text-white rounded-full transition-colors" title="Unduh Foto">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                </a>
                <button onclick="closeIncPhotoModal()" class="p-2.5 bg-white/10 hover:bg-white/20 text-white rounded-full transition-colors" title="Tutup">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="max-w-4xl max-h-[85vh] w-full flex flex-col items-center justify-center">
                <img id="inc-modal-img" src="" alt="Preview Foto Telur" class="max-w-full max-h-[80vh] object-contain rounded-2xl shadow-2xl">
                <p id="inc-modal-time" class="text-gray-300 text-xs sm:text-sm mt-3 font-medium font-mono"></p>
                <div id="inc-modal-fertility" class="hidden mt-3 w-full max-w-md rounded-xl bg-white/10 border border-white/20 px-4 py-3 text-center">
                    <p id="inc-modal-fertility-text" class="text-xs text-gray-200"></p>
                </div>
            </div>
        </div>

        <!-- KARTU GABUNGAN TEMPERATURE + HUMIDITY HISTORY (bisa dibuka/ditutup) -->
        <div
            class="mt-6 sm:mt-12 bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-8 shadow-[10px_10px_20px_rgba(0,0,0,0.05)] border border-gray-100 hover:shadow-2xl transition-all duration-300">
            <!-- Header: klik untuk buka/tutup -->
            <button type="button" onclick="toggleHistory()"
                class="w-full flex items-center justify-between gap-3 cursor-pointer select-none">
                <span
                    class="flex items-center gap-1.5 sm:gap-3 font-bold uppercase tracking-wide text-[11px] sm:text-base text-left">
                    <span class="flex items-center gap-0.5 sm:gap-1">
                        <!-- Ikon termometer -->
                        <svg class="w-4 h-4 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                            stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 14.76V5a2 2 0 10-4 0v9.76a4 4 0 104 0z" />
                        </svg>
                        <!-- Ikon tetes air -->
                        <svg class="w-4 h-4 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                            stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0L12 2.69z" />
                        </svg>
                    </span>
                    <h2>TEMPERATURE &amp; HUMIDITY HISTORY</h2>
                    <span
                        class="hidden lg:inline-flex items-center gap-2 normal-case tracking-normal font-semibold text-xs text-gray-400 ml-1">
                        <span id="hist-summary-temp" class="font-bold text-gray-800">--</span>
                        <span class="text-gray-300">|</span>
                        <span id="hist-summary-hum" class="font-bold text-gray-800">--</span>
                    </span>
                </span>
                <svg id="history-arrow" class="w-5 h-5 text-gray-500 shrink-0 transition-transform duration-200" fill="none"
                    stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
            </button>

            <!-- Konten: tersembunyi saat halaman dimuat, buka lewat header -->
            <div id="history-content" class="hidden mt-4 sm:mt-6">
                <!-- Bar pemilih tanggal -->
                <div
                    class="flex flex-wrap items-center gap-2.5 sm:gap-3 bg-gray-50 rounded-xl border border-gray-100 p-3 mb-5 sm:mb-8">
                    <div class="p-1.5 bg-cream-bg text-accent-brown rounded-lg shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div class="flex-1 min-w-[180px]">
                        <p id="log-range-label" class="text-xs sm:text-sm font-semibold text-gray-800">15 log terakhir
                        </p>
                    </div>
                    <input type="date" id="log-date" max="<%= new Date().toISOString().slice(0,10) %>"
                        class="rounded-xl border border-gray-200 bg-white px-3 py-2 text-xs sm:text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-accent-brown/40">
                    <button onclick="loadHistoryToday()"
                        class="rounded-xl bg-[#C69C6D] hover:bg-[#b8885a] text-black px-3 py-2 text-xs sm:text-sm font-bold shadow-sm shadow-batch-brown/30 transition-colors">Hari
                        Ini</button>
                    <button onclick="loadHistoryLatest()"
                        class="rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 text-xs sm:text-sm font-bold transition-colors">Terbaru</button>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-10">
                    <!-- Temperature -->
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <h4 class="text-[10px] sm:text-xs font-bold uppercase text-gray-500 tracking-wider">Temperature
                            </h4>
                            <div class="flex gap-2.5 sm:gap-4 text-[9px] sm:text-[10px] font-bold uppercase tracking-tight">
                                <div class="flex items-center gap-1"><span class="w-2.5 h-0.5 bg-[#ef4444] rounded-full"></span>
                                    High</div>
                                <div class="flex items-center gap-1"><span class="w-2.5 h-0.5 bg-[#386628] rounded-full"></span>
                                    Avg</div>
                                <div class="flex items-center gap-1"><span class="w-2.5 h-0.5 bg-[#3b82f6] rounded-full"></span>
                                    Low</div>
                            </div>
                        </div>
                        <div class="relative w-full h-56 sm:h-72">
                            <canvas id="tempChart"></canvas>
                        </div>
                    </div>

                    <!-- Humidity -->
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <h4 class="text-[10px] sm:text-xs font-bold uppercase text-gray-500 tracking-wider">Humidity
                            </h4>
                            <div class="flex gap-2.5 sm:gap-4 text-[9px] sm:text-[10px] font-bold uppercase tracking-tight">
                                <div class="flex items-center gap-1"><span class="w-2.5 h-0.5 bg-[#f59e0b] rounded-full"></span>
                                    High</div>
                                <div class="flex items-center gap-1"><span class="w-2.5 h-0.5 bg-[#1E88E5] rounded-full"></span>
                                    Avg</div>
                                <div class="flex items-center gap-1"><span class="w-2.5 h-0.5 bg-[#6366f1] rounded-full"></span>
                                    Low</div>
                            </div>
                        </div>
                        <div class="relative w-full h-56 sm:h-72">
                            <canvas id="humChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>

    <!-- MODAL INFO / PANDUAN MODUL ESP32-S3 CAM -->
    <div id="cam-info-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-gray-100 relative max-h-[90vh] overflow-y-auto">
            <button onclick="closeCamInfoModal()" class="absolute top-5 right-5 text-gray-400 hover:text-gray-700 p-1 rounded-full hover:bg-gray-100 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>

            <div class="flex items-center gap-3 mb-4">
                <div class="p-2.5 bg-cream-bg text-accent-brown rounded-2xl">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path></svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-gray-900">Modul Kamera ESP32-S3</h3>
                    <p class="text-xs text-gray-500">Konfigurasi perangkat kamera untuk <%= device_data.device_name %></p>
                </div>
            </div>

            <p class="text-xs text-gray-600 mb-4 leading-relaxed">
                Kamera terhubung langsung ke inkubator ini. Masukkan parameter berikut ke file <code class="bg-white text-accent-brown px-1.5 py-0.5 rounded font-mono font-bold">secret.h</code> pada firmware ESP32-S3 CAM Anda:
            </p>

            <div class="bg-gray-900 text-green-400 font-mono text-xs rounded-2xl p-4 mb-4 relative overflow-x-auto select-all">
                <p><span class="text-accent-brown">// Device ID Inkubator Ini:</span></p>
                <p>const int DEVICE_ID = <span class="text-yellow-300 font-bold"><%= device_data.device_id %></span>;</p>
                <p class="mt-2"><span class="text-accent-brown">// MQTT Topics:</span></p>
                <p><span class="text-gray-400">Subscribe :</span> incubator/<%= device_data.device_id %>/con</p>
                <p><span class="text-gray-400">Publish   :</span> incubator/<%= device_data.device_id %>/data</p>
                <p class="mt-2"><span class="text-accent-brown">// Upload HTTP Endpoint:</span></p>
                <p class="text-gray-300">/api/devices/<%= device_data.device_id %>/camera/upload</p>
            </div>

            <div class="bg-cream-bg rounded-2xl p-4 border border-accent-brown/20 text-xs text-dark-text mb-5">
                <p class="font-bold mb-1">Cara Kerja:</p>
                <ol class="list-decimal ml-4 space-y-1 text-gray-600">
                    <li>Saat Anda klik <b>"Ambil Foto Sekarang"</b>, dashboard mengirim pesan MQTT <code class="font-mono bg-white text-accent-brown px-1 py-0.5 rounded font-bold">{"action":"capture"}</code>.</li>
                    <li>ESP32-S3 CAM mengambil foto dari sensor kamera OV5640/OV2640.</li>
                    <li>ESP32-S3 mengunggah gambar via HTTP POST langsung ke dashboard inkubator.</li>
                    <li>Foto langsung tersimpan dan otomatis tampil di layar inkubator secara realtime!</li>
                </ol>
            </div>

            <button type="button" onclick="closeCamInfoModal()" class="w-full bg-gray-900 hover:bg-black text-white font-bold py-3 rounded-xl text-xs transition-colors">
                Tutup Panduan
            </button>
        </div>
    </div>

    <!-- MODAL PREVIEW FOTO BESAR -->
    <div id="inc-photo-modal" class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex flex-col items-center justify-center p-4">
        <div class="absolute top-4 right-4 flex items-center gap-3">
            <a id="inc-modal-download" href="#" download class="p-2.5 bg-white/10 hover:bg-white/20 text-white rounded-full transition-colors" title="Unduh Foto">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            </a>
            <button onclick="closeIncPhotoModal()" class="p-2.5 bg-white/10 hover:bg-white/20 text-white rounded-full transition-colors" title="Tutup">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="max-w-4xl max-h-[85vh] w-full flex flex-col items-center justify-center">
            <img id="inc-modal-img" src="" alt="Preview Foto Telur" class="max-w-full max-h-[80vh] object-contain rounded-2xl shadow-2xl">
            <p id="inc-modal-time" class="text-gray-300 text-xs sm:text-sm mt-3 font-medium font-mono"></p>
        </div>
    </div>

    <script>
        const savedTargets = <%- JSON.stringify(saved_targets || null) %>;
        const _num = (v, def) => (v !== null && v !== undefined && !Number.isNaN(parseFloat(v))) ? parseFloat(v) : def;
        let currentTargetTemp = _num(savedTargets && savedTargets.target_temp, 37.5);
        let currentTargetHum = _num(savedTargets && savedTargets.target_hum, 55);
        let currentTargetFan = _num(savedTargets && savedTargets.fan_speed, 50);
        const userRole = container.dataset.role;
        const isViewer = userRole === 'viewer';

        // --- CHART INTERFACE ---
        const ctxTemp = document.getElementById('tempChart').getContext('2d');
        const tempChart = new Chart(ctxTemp, {
            type: 'line',
            data: {
                labels: JSON.parse(container.dataset.chartLabels).map(t => {
                    const d = new Date(t);
                    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
                }),
                datasets: [
                    {
                        label: 'High (°C)',
                        data: JSON.parse(container.dataset.chartTempHigh),
                        borderColor: '#ef4444',
                        borderDash: [5, 5],
                        borderWidth: 1,
                        fill: false,
                        pointRadius: 0,
                        tension: 0.4
                    },
                    {
                        label: 'Average (°C)',
                        data: JSON.parse(container.dataset.chartTempAvg),
                        borderColor: '#386628',
                        backgroundColor: 'rgba(56, 102, 40, 0.05)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 2
                    },
                    {
                        label: 'Low (°C)',
                        data: JSON.parse(container.dataset.chartTempLow),
                        borderColor: '#3b82f6',
                        borderDash: [5, 5],
                        borderWidth: 1,
                        fill: false,
                        pointRadius: 0,
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        grace: 5,
                        ticks: { font: { size: 10 } }
                    },
                    x: { ticks: { font: { size: 10 } } }
                }
            }
        });

        const ctxHum = document.getElementById('humChart').getContext('2d');
        const humChart = new Chart(ctxHum, {
            type: 'line',
            data: {
                labels: JSON.parse(container.dataset.chartLabels).map(t => {
                    const d = new Date(t);
                    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
                }),
                datasets: [
                    {
                        label: 'High (%)',
                        data: JSON.parse(container.dataset.chartHumHigh),
                        borderColor: '#f59e0b',
                        borderDash: [5, 5],
                        borderWidth: 1,
                        fill: false,
                        pointRadius: 0,
                        tension: 0.4
                    },
                    {
                        label: 'Average (%)',
                        data: JSON.parse(container.dataset.chartHumAvg),
                        borderColor: '#1E88E5',
                        backgroundColor: 'rgba(30, 136, 229, 0.05)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 2
                    },
                    {
                        label: 'Low (%)',
                        data: JSON.parse(container.dataset.chartHumLow),
                        borderColor: '#6366f1',
                        borderDash: [5, 5],
                        borderWidth: 1,
                        fill: false,
                        pointRadius: 0,
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        grace: 5,
                        ticks: { font: { size: 10 } }
                    },
                    x: { ticks: { font: { size: 10 } } }
                }
            }
        });

        let lastChartUpdate = Date.now();

        // --- Pemuat riwayat log per tanggal ---
        const logDateInput = document.getElementById('log-date');
        const logRangeLabel = document.getElementById('log-range-label');

        function fmtTanggalLabel(dateStr, count) {
            const d = new Date(dateStr + 'T00:00:00');
            const hari = d.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
            return `${hari} — ${count} titik data`;
        }

        function applyChartData(logs) {
            // Urutkan lama -> baru untuk sumbu X
            logs.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
            const labels = logs.map(l => new Date(l.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false }));
            const pick = (key) => logs.map(l => (l.data[key] && l.data[key].avg !== undefined) ? l.data[key].avg : null);
            const tAvg = pick('temp'), tHigh = logs.map(l => l.data.temp ? l.data.temp.high : null), tLow = logs.map(l => l.data.temp ? l.data.temp.low : null);
            const hAvg = logs.map(l => l.data.hum ? l.data.hum.avg : null), hHigh = logs.map(l => l.data.hum ? l.data.hum.high : null), hLow = logs.map(l => l.data.hum ? l.data.hum.low : null);

            tempChart.data.labels = labels;
            tempChart.data.datasets[0].data = tHigh;
            tempChart.data.datasets[1].data = tAvg;
            tempChart.data.datasets[2].data = tLow;
            tempChart.update();

            humChart.data.labels = labels;
            humChart.data.datasets[0].data = hHigh;
            humChart.data.datasets[1].data = hAvg;
            humChart.data.datasets[2].data = hLow;
            humChart.update();
        }

        async function loadHistory(dateStr) {
            if (!logRangeLabel) return;
            try {
                logRangeLabel.classList.add('text-gray-400');
                logRangeLabel.innerText = 'Memuat log...';
                const url = dateStr
                    ? `/api/devices/${deviceId}/logs?date=${encodeURIComponent(dateStr)}`
                    : `/api/devices/${deviceId}/logs`;
                const res = await fetch(url);
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const logs = await res.json();

                applyChartData(logs);

                if (dateStr) {
                    logRangeLabel.classList.remove('text-gray-400');
                    logRangeLabel.innerText = logs.length
                        ? fmtTanggalLabel(dateStr, logs.length)
                        : 'Tidak ada log pada tanggal ini';
                } else {
                    logRangeLabel.classList.remove('text-gray-400');
                    logRangeLabel.innerText = logs.length
                        ? `${logs.length} log terakhir (lintas hari)`
                        : 'Belum ada log tersimpan';
                }
            } catch (e) {
                logRangeLabel.classList.remove('text-gray-400');
                logRangeLabel.innerText = 'Gagal memuat log: ' + e.message;
            }
        }

        function loadHistoryToday() {
            logDateInput.value = logDateInput.max || new Date().toISOString().slice(0, 10);
            loadHistory(logDateInput.value);
        }

        function loadHistoryLatest() {
            logDateInput.value = '';
            loadHistory(null);
        }

        if (logDateInput) {
            logDateInput.addEventListener('change', () => loadHistory(logDateInput.value || null));
        }

        // Servo state
        let currentMode = null;
        let currentInterval = null;
        let pendingInterval = 1;

        // Socket.IO CONNECTION
        const socket = io({
            auth: {
                username: '<%= username %>',
                userId: '<%= userId %>'
            }
        });

        socket.on('connect', () => {
            updateStatus('Connected (Online)', 'text-green-600');
            socket.emit('join-device', deviceId);
        });

        socket.on('disconnect', () => {
            updateStatus('Disconnected!', 'text-red-600');
        });

        socket.on('joined', (id) => {
            if (id === deviceId) {
                socket.emit('request-info', deviceId);
                pingCameraNow();
            }
        });

        socket.on('connect_error', (err) => {
            updateStatus('Connection Error', 'text-red-600');
            console.error('Socket Error:', err.message);
        });

        socket.on('error', (msg) => {
            console.error('Socket Error:', msg);
        });

        socket.on('control-ack', ({ published }) => {
            if (published === false) {
                showToast('Inkubator offline — target disimpan & otomatis diterapkan saat online');
            }
        });

        socket.on('mqtt-message', ({ topic, data }) => {
            if (data.temperature !== undefined) {
                document.getElementById('suhu').innerText = parseFloat(data.temperature).toFixed(2);
                const histT = document.getElementById('hist-summary-temp');
                if (histT) histT.innerText = parseFloat(data.temperature).toFixed(1) + '°C';
            }
            if (data.humidity !== undefined) {
                document.getElementById('kelembapan').innerText = parseFloat(data.humidity).toFixed(2);
                const histH = document.getElementById('hist-summary-hum');
                if (histH) histH.innerText = Math.round(parseFloat(data.humidity)) + '%';
            }
            if (data.target_temp !== undefined || data.t_temp !== undefined) {
                currentTargetTemp = parseFloat(data.target_temp || data.t_temp);
                document.getElementById('target-temp').innerText = currentTargetTemp.toFixed(1) + ' °C';
            }
            if (data.target_hum !== undefined || data.t_hum !== undefined) {
                currentTargetHum = parseFloat(data.target_hum || data.t_hum);
                document.getElementById('target-hum').innerText = Math.round(currentTargetHum) + '%';
            }
            if (data.target_fan !== undefined || data.fan_speed !== undefined) {
                currentTargetFan = parseFloat(data.target_fan !== undefined ? data.target_fan : data.fan_speed);
                document.getElementById('target-fan').innerText = currentTargetFan + '%';
                const fsFan = document.getElementById('fs-summary-fan');
                if (fsFan) fsFan.innerText = currentTargetFan + '%';
            }

            if (data.servo_mode !== undefined) {
                currentMode = parseInt(data.servo_mode);
                updateModeUI(currentMode);
            }
            if (data.servo_interval !== undefined) {
                currentInterval = parseInt(data.servo_interval);
                updateIntervalUI(currentInterval);
                pendingInterval = currentInterval;
            }

            // Append live data to chart every 1 minute
            if (Date.now() - lastChartUpdate >= 60000 && data.temperature !== undefined && data.humidity !== undefined) {
                const timeNow = new Date().toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute: '2-digit' });
                const liveTemp = parseFloat(data.temperature).toFixed(2);
                const liveHum = parseFloat(data.humidity).toFixed(2);

                tempChart.data.labels.push(timeNow);
                tempChart.data.datasets[0].data.push(liveTemp);
                tempChart.data.datasets[1].data.push(liveTemp);
                tempChart.data.datasets[2].data.push(liveTemp);
                if (tempChart.data.labels.length > 15) {
                    tempChart.data.labels.shift();
                    tempChart.data.datasets.forEach(ds => ds.data.shift());
                }
                tempChart.update('none');

                humChart.data.labels.push(timeNow);
                humChart.data.datasets[0].data.push(liveHum);
                humChart.data.datasets[1].data.push(liveHum);
                humChart.data.datasets[2].data.push(liveHum);
                if (humChart.data.labels.length > 15) {
                    humChart.data.labels.shift();
                    humChart.data.datasets.forEach(ds => ds.data.shift());
                }
                humChart.update('none');

                lastChartUpdate = Date.now();
            }
        });

        function updateTarget(type, change) {
            if (isViewer) return;
            if (type === 'temp') currentTargetTemp = parseFloat((currentTargetTemp + change).toFixed(1));
            else if (type === 'hum') currentTargetHum = currentTargetHum + change;
            else if (type === 'fan') currentTargetFan = Math.max(0, Math.min(100, currentTargetFan + change));

            document.getElementById('target-temp').innerText = currentTargetTemp.toFixed(1) + ' °C';
            document.getElementById('target-hum').innerText = Math.round(currentTargetHum) + '%';
            document.getElementById('target-fan').innerText = currentTargetFan + '%';
            const fsFan = document.getElementById('fs-summary-fan');
            if (fsFan) fsFan.innerText = currentTargetFan + '%';
            sendTargetData();
        }

        function changeBatchType() {
            const settings = batchPresets[document.getElementById('batch-select').value];
            if (settings) {
                currentTargetTemp = settings.temp;
                currentTargetHum = settings.hum;
                document.getElementById('target-temp').innerText = currentTargetTemp + ' °C';
                document.getElementById('target-hum').innerText = currentTargetHum + '%';
                document.getElementById('info-optimal-temp').innerText = settings.infoTemp;
                document.getElementById('info-optimal-hum').innerText = settings.infoHum;
                sendTargetData();
            }
        }

        function sendTargetData() {
            socket.emit('device-control', {
                deviceId,
                command: { target_temp: currentTargetTemp, target_hum: currentTargetHum, fan_speed: currentTargetFan }
            });
        }

        function updateStatus(text, colorClass) {
            const s = document.getElementById('status');
            s.innerText = 'Status: ' + text;
            s.className = 'mt-2 text-sm font-medium ' + colorClass;
        }

        // Custom batch dropdown logic
        function toggleBatchDropdown(e) {
            e.stopPropagation();
            const menu = document.getElementById('batch-dropdown-menu');
            const arrow = document.getElementById('batch-dropdown-arrow');
            const isOpen = menu.classList.contains('open');
            menu.classList.toggle('open', !isOpen);
            arrow.style.transform = isOpen ? '' : 'rotate(180deg)';
        }

        function selectBatch(value, label) {
            document.getElementById('batch-dropdown-label').textContent = label;
            document.querySelectorAll('#batch-dropdown-menu button').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            const sel = document.getElementById('batch-select');
            sel.value = value;
            changeBatchType();
            document.getElementById('batch-dropdown-menu').classList.remove('open');
            document.getElementById('batch-dropdown-arrow').style.transform = '';
        }

        document.addEventListener('click', function (e) {
            const dropdown = document.getElementById('batch-dropdown');
            if (dropdown && !dropdown.contains(e.target)) {
                document.getElementById('batch-dropdown-menu').classList.remove('open');
                document.getElementById('batch-dropdown-arrow').style.transform = '';
            }
        });

        // --- SERVO FUNCTIONS ---
        function setServoMode(mode) {
            if (isViewer) return;
            socket.emit('device-control', {
                deviceId,
                command: { servo_mode: mode }
            });
            currentMode = mode;
            updateModeUI(mode);
            showToast('Mengubah mode ke ' + (mode === 0 ? 'JADWAL' : 'SWING'));
        }

        function changeInterval(delta) {
            if (isViewer) return;
            pendingInterval = Math.max(1, pendingInterval + delta);
            document.getElementById('interval-value').innerText = pendingInterval;
        }

        function applyInterval() {
            if (isViewer) return;
            socket.emit('device-control', {
                deviceId,
                command: { servo_interval: pendingInterval }
            });
            currentInterval = pendingInterval;
            updateIntervalUI(currentInterval);
            showToast('Interval diubah ke ' + pendingInterval + ' jam');
        }

        function updateModeUI(mode) {
            const textEl = document.getElementById('current-mode-text');
            if (textEl) textEl.innerText = mode === 0 ? 'JADWAL' : 'SWING';
            const summaryMode = document.getElementById('fs-summary-mode');
            if (summaryMode) summaryMode.innerText = mode === 0 ? 'JADWAL' : 'SWING';
            document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
            if (mode === 0) {
                document.getElementById('mode-jadwal').classList.add('active');
                document.getElementById('servo-interval-section').classList.remove('hidden');
            } else {
                document.getElementById('mode-swing').classList.add('active');
                document.getElementById('servo-interval-section').classList.add('hidden');
            }
        }

        function updateIntervalUI(interval) {
            const textEl = document.getElementById('current-interval-text');
            const valEl = document.getElementById('interval-value');
            if (textEl) textEl.innerText = interval;
            if (valEl) valEl.innerText = interval;
        }

        function toggleFanServo() {
            const content = document.getElementById('fan-servo-content');
            const arrow = document.getElementById('fan-servo-arrow');
            const isHidden = content.classList.toggle('hidden');
            arrow.style.transform = isHidden ? '' : 'rotate(180deg)';
            try { localStorage.setItem('fs-open', isHidden ? '0' : '1'); } catch (e) {}
        }

        function toggleHistory() {
            const content = document.getElementById('history-content');
            const arrow = document.getElementById('history-arrow');
            const isHidden = content.classList.toggle('hidden');
            arrow.style.transform = isHidden ? '' : 'rotate(180deg)';
            if (!isHidden) {
                // Paksa chart menyesuaikan ukuran setelah konten tampil
                if (typeof tempChart !== 'undefined') tempChart.resize();
                if (typeof humChart !== 'undefined') humChart.resize();
            }
            try { localStorage.setItem('hist-open', isHidden ? '0' : '1'); } catch (e) {}
        }

        // Buka otomatis saat halaman dimuat bila terakhir dibiarkan terbuka
        (function () {
            try {
                if (localStorage.getItem('hist-open') === '1') {
                    document.getElementById('history-content').classList.remove('hidden');
                    document.getElementById('history-arrow').style.transform = 'rotate(180deg)';
                }
            } catch (e) {}
        })();

        // Ringkasan header history dari titik data terakhir saat halaman dimuat
        (function initHistSummary() {
            try {
                const tAvg = JSON.parse(container.dataset.chartTempAvg);
                const hAvg = JSON.parse(container.dataset.chartHumAvg);
                const histT = document.getElementById('hist-summary-temp');
                const histH = document.getElementById('hist-summary-hum');
                if (tAvg.length && histT) histT.innerText = parseFloat(tAvg[tAvg.length - 1]).toFixed(1) + '°C';
                if (hAvg.length && histH) histH.innerText = Math.round(hAvg[hAvg.length - 1]) + '%';
            } catch (e) {}
        })();

        // Buka otomatis saat halaman dimuat bila terakhir dibiarkan terbuka
        (function () {
            try {
                if (localStorage.getItem('fs-open') === '1') {
                    document.getElementById('fan-servo-content').classList.remove('hidden');
                    document.getElementById('fan-servo-arrow').style.transform = 'rotate(180deg)';
                }
            } catch (e) {}
        })();

        // Tampilkan target tersimpan (dari DB) di UI saat halaman dimuat
        (function applySavedTargets() {
            document.getElementById('target-temp').innerText = currentTargetTemp.toFixed(1) + ' °C';
            document.getElementById('target-hum').innerText = Math.round(currentTargetHum) + '%';
            document.getElementById('target-fan').innerText = currentTargetFan + '%';
            const fsFan = document.getElementById('fs-summary-fan');
            if (fsFan) fsFan.innerText = currentTargetFan + '%';
            if (savedTargets && savedTargets.servo_mode !== null && savedTargets.servo_mode !== undefined) {
                currentMode = parseInt(savedTargets.servo_mode);
                updateModeUI(currentMode);
            }
            if (savedTargets && savedTargets.servo_interval !== null && savedTargets.servo_interval !== undefined) {
                currentInterval = parseInt(savedTargets.servo_interval);
                pendingInterval = currentInterval;
                updateIntervalUI(currentInterval);
            }
        })();

        function showToast(msg) {
            const existing = document.querySelector('.toast-servo');
            if (existing) existing.remove();
            const toast = document.createElement('div');
            toast.className = 'toast-servo fixed bottom-6 left-1/2 -translate-x-1/2 bg-gray-900 text-white px-5 py-3 rounded-xl text-sm font-medium shadow-lg z-50';
            toast.style.animation = 'fadeInUp 0.3s ease';
            toast.innerText = msg;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 2000);
        }

        // --- INCUBATOR CAMERA INTEGRATION ---
        let isCamCapturing = false;
        let currentCamMac = '<%= device_data.camera_mac || "" %>';

        // --- FERTILITY ANALYSIS STATE ---
        const fertilityEnabled = <%- (typeof fertility_enabled !== 'undefined' && fertility_enabled) ? 'true' : 'false' %>;
        const fertilityByPhotoId = {};
        <% _recentPhotos.forEach(p => { %>
        fertilityByPhotoId[<%= p.id %>] = <%- JSON.stringify(p.fertility || null) %>;
        <% }) %>
        let latestPhotoId = <%= _latestCam ? _latestCam.id : 'null' %>;
        let latestFertility = <%- JSON.stringify(_latestCam && _latestCam.fertility ? _latestCam.fertility : null) %>;
        let currentModalPhotoId = null;

        function formatFertilityRate(summary) {
            if (!summary) return '-';
            if (summary.fertility_rate_pct !== undefined && summary.fertility_rate_pct !== null) {
                return `${Number(summary.fertility_rate_pct).toFixed(1)}%`;
            }
            const total = Number(summary.total_detected || 0);
            const fertile = Number(summary.fertile || 0);
            return total > 0 ? `${((fertile / total) * 100).toFixed(1)}%` : '-';
        }

        function renderFertilityPanel(result) {
            if (!fertilityEnabled) return;
            const panel = document.getElementById('inc-fertility-panel');
            const statusEl = document.getElementById('inc-fertility-status');
            const statsEl = document.getElementById('inc-fertility-stats');
            const detailEl = document.getElementById('inc-fertility-detail');
            const linkEl = document.getElementById('inc-fertility-annotated-link');
            if (!panel || !statusEl) return;

            panel.classList.remove('hidden');
            statsEl.classList.add('hidden');
            detailEl.classList.add('hidden');
            linkEl.classList.add('hidden');
            linkEl.href = '#';

            if (!result) {
                statusEl.innerText = 'Belum dianalisis';
                statusEl.className = 'text-xs text-gray-500 mt-0.5';
                return;
            }
            if (result.status === 'processing') {
                statusEl.innerText = 'Sedang menganalisis telur...';
                statusEl.className = 'text-xs text-amber-600 mt-0.5 font-semibold';
                return;
            }
            if (result.status === 'failed') {
                statusEl.innerText = 'Analisis gagal: ' + (result.error || 'tidak diketahui');
                statusEl.className = 'text-xs text-red-500 mt-0.5';
                return;
            }

            const summary = result.summary || {};
            const fertile = Number(summary.fertile || 0);
            const infertile = Number(summary.infertile || 0);
            const total = Number(summary.total_detected || (fertile + infertile));

            document.getElementById('inc-fertility-fertile').innerText = fertile;
            document.getElementById('inc-fertility-infertile').innerText = infertile;
            document.getElementById('inc-fertility-rate').innerText = formatFertilityRate(summary);
            statusEl.innerText = `Analisis selesai • ${total} telur terdeteksi`;
            statusEl.className = 'text-xs text-emerald-600 mt-0.5 font-semibold';
            statsEl.classList.remove('hidden');

            if (result.classifier_used) {
                detailEl.innerText = `Model: ${result.classifier_used}`;
                detailEl.classList.remove('hidden');
            }
            if (result.annotated_filepath) {
                linkEl.href = result.annotated_filepath;
                linkEl.classList.remove('hidden');
            }
        }

        function renderModalFertility(result) {
            if (!fertilityEnabled) return;
            const box = document.getElementById('inc-modal-fertility');
            const text = document.getElementById('inc-modal-fertility-text');
            if (!box || !text) return;
            if (!result) {
                box.classList.add('hidden');
                return;
            }
            box.classList.remove('hidden');
            if (result.status === 'processing') {
                text.innerText = 'Sedang menganalisis fertilitas...';
            } else if (result.status === 'failed') {
                text.innerText = 'Analisis gagal: ' + (result.error || 'tidak diketahui');
            } else {
                const s = result.summary || {};
                text.innerText = `Fertile: ${s.fertile || 0} • Infertile: ${s.infertile || 0} • Rate: ${formatFertilityRate(s)}`;
            }
        }

        renderFertilityPanel(latestFertility);

        // --- CAMERA PAIRING LOGIC (MAC ADDRESS) ---
        function toggleCamSettings(e) {
            if (e) e.stopPropagation();
            const menu = document.getElementById('cam-settings-menu');
            if (menu) menu.classList.toggle('hidden');
        }

        function closeCamSettings() {
            const menu = document.getElementById('cam-settings-menu');
            if (menu) menu.classList.add('hidden');
        }

        document.addEventListener('click', function (e) {
            const wrap = document.getElementById('cam-settings-wrap');
            if (wrap && !wrap.contains(e.target)) closeCamSettings();
        });

        function openCamPairModal() {
            if (isViewer) {
                showToast('Hanya owner/operator yang dapat mengatur kamera');
                return;
            }
            const m = document.getElementById('cam-pair-modal');
            if (m) m.classList.remove('hidden');
        }

        function closeCamPairModal() {
            const m = document.getElementById('cam-pair-modal');
            if (m) m.classList.add('hidden');
        }

        async function submitCameraPair(event) {
            event.preventDefault();
            const macInput = document.getElementById('input-cam-mac');
            const btn = document.getElementById('btn-submit-pair');
            if (!macInput) return;

            const macVal = macInput.value.trim();
            if (!macVal) {
                alert('Silakan masukkan ID Kamera / MAC Address');
                return;
            }

            btn.disabled = true;
            btn.innerText = 'Menyimpan...';

            try {
                const res = await fetch(`/api/devices/${deviceId}/camera/pair`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ camera_mac: macVal })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || 'Kamera berhasil disandingkan!');
                    updateCamPairUI(data.camera_mac);
                    closeCamPairModal();
                } else {
                    alert('Gagal menyandingkan: ' + (data.error || 'Terjadi kesalahan'));
                }
            } catch (err) {
                alert('Error: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerText = 'Simpan & Sandingkan';
            }
        }

        async function unpairCamera() {
            if (isViewer) return;
            if (!confirm(`Lepas sandingan kamera (${currentCamMac}) dari inkubator ini?`)) return;

            try {
                const res = await fetch(`/api/devices/${deviceId}/camera/unpair`, {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (data.success) {
                    showToast('Kamera berhasil dilepas');
                    updateCamPairUI(null);
                } else {
                    alert('Gagal melepas kamera: ' + (data.error || 'Terjadi kesalahan'));
                }
            } catch (err) {
                alert('Error: ' + err.message);
            }
        }

        function updateCamPairUI(mac) {
            currentCamMac = mac || '';
            const badge = document.getElementById('inc-cam-pair-badge');
            const dot = document.getElementById('inc-cam-pair-dot');
            const macText = document.getElementById('inc-cam-mac-text');
            const btnLabel = document.getElementById('btn-pair-label');
            const unpairBtn = document.getElementById('btn-unpair-cam');
            const infoMac = document.getElementById('modal-info-mac');
            const infoSub = document.getElementById('modal-info-topic-sub');
            const infoPub = document.getElementById('modal-info-topic-pub');

            if (mac) {
                if (badge) {
                    badge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold flex items-center gap-1.5 bg-emerald-50 text-emerald-700 border border-emerald-200';
                }
                if (dot) dot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-500';
                if (macText) macText.innerText = mac;
                if (btnLabel) btnLabel.innerText = 'Ganti Sandingan';
                if (unpairBtn) unpairBtn.classList.remove('hidden');
                if (infoMac) infoMac.innerText = mac;
                if (infoSub) infoSub.innerText = mac;
                if (infoPub) infoPub.innerText = mac;
            } else {
                if (badge) {
                    badge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold flex items-center gap-1.5 bg-amber-50 text-amber-700 border border-amber-200';
                }
                if (dot) dot.className = 'w-1.5 h-1.5 rounded-full bg-amber-500';
                if (macText) macText.innerText = 'Belum Tersanding';
                if (btnLabel) btnLabel.innerText = 'Sandingkan Kamera';
                if (unpairBtn) unpairBtn.classList.add('hidden');
                if (infoMac) infoMac.innerText = '(Belum disandingkan)';
                if (infoSub) infoSub.innerText = '<ID_KAMERA>';
                if (infoPub) infoPub.innerText = '<ID_KAMERA>';
            }
        }

        // --- ON-DEMAND CAMERA STATUS (TRIGGER SAAT DASHBOARD DIMUAT) ---
        let camPingTimeout = null;

        function pingCameraNow() {
            const statusEl = document.getElementById('inc-cam-status');
            const dotEl = document.getElementById('inc-cam-status-dot');

            if (statusEl) {
                statusEl.innerText = 'Memeriksa status kamera...';
                statusEl.className = 'text-xs text-amber-600 font-medium truncate';
            }
            if (dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-amber-400 animate-pulse shrink-0';

            // Kirim ping ke ESP32-S3 Cam via backend & MQTT
            socket.emit('camera-ping', { deviceId });

            if (camPingTimeout) clearTimeout(camPingTimeout);
            camPingTimeout = setTimeout(() => {
                if (statusEl && statusEl.innerText.includes('Memeriksa')) {
                    statusEl.innerText = 'Kamera Siaga (Standby / Belum aktif)';
                    statusEl.className = 'text-xs text-gray-500 truncate';
                    if (dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-gray-400 shrink-0';
                }
            }, 6000);
        }

        socket.on('camera-online-status', (info) => {
            if (camPingTimeout) clearTimeout(camPingTimeout);
            const statusEl = document.getElementById('inc-cam-status');
            const dotEl = document.getElementById('inc-cam-status-dot');

            if (statusEl) {
                let detail = 'Kamera Terhubung (Online)';
                if (info.ip) detail += ` • IP: ${info.ip}`;
                if (info.rssi) detail += ` • Sinyal: ${info.rssi} dBm`;
                statusEl.innerText = detail;
                statusEl.className = 'text-xs text-emerald-600 font-semibold truncate';
            }
            if (dotEl) {
                dotEl.className = 'w-2 h-2 rounded-full bg-emerald-500 shrink-0';
            }
        });

        socket.on('camera-paired', (data) => {
            if (data.deviceId == deviceId) {
                updateCamPairUI(data.camera_mac);
            }
        });

        socket.on('camera-unpaired', (data) => {
            if (data.deviceId == deviceId) {
                updateCamPairUI(null);
            }
        });

        socket.on('camera-photo-received', (photo) => {
            console.log('[Inkubator] Foto baru dari kamera diterima:', photo);
            showToast('Foto baru dari ESP32-S3 Cam berhasil diterima!');
            setIncCamLoading(false, 'Foto berhasil diperbarui');
            
            const photoEl = document.getElementById('inc-latest-photo');
            const noPhotoEl = document.getElementById('inc-no-photo');
            const timeEl = document.getElementById('inc-photo-time');
            const flash = document.getElementById('inc-capture-flash');

            latestPhotoId = Number(photo.id);
            latestFertility = null;
            fertilityByPhotoId[latestPhotoId] = null;
            renderFertilityPanel(null);

            if (photoEl) {
                photoEl.src = photo.filepath + '?t=' + Date.now();
                photoEl.classList.remove('hidden');
                photoEl.onclick = () => openIncPhotoModal(photo.filepath, photo.captured_at, photo.id);
            }
            if (noPhotoEl) noPhotoEl.classList.add('hidden');
            if (timeEl) {
                const d = new Date(photo.captured_at || Date.now());
                timeEl.innerText = d.toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'medium' });
            }

            if (flash) {
                flash.classList.remove('opacity-0');
                flash.classList.add('opacity-75');
                setTimeout(() => {
                    flash.classList.remove('opacity-75');
                    flash.classList.add('opacity-0');
                }, 150);
            }

            // Tambahkan ke mini grid
            const grid = document.getElementById('inc-recent-grid');
            if (grid) {
                const thumb = document.createElement('div');
                thumb.className = 'aspect-square rounded-xl overflow-hidden bg-gray-100 border border-gray-200 cursor-pointer hover:opacity-80 transition-opacity animate-fade-in';
                thumb.onclick = () => openIncPhotoModal(photo.filepath, photo.captured_at, photo.id);
                thumb.innerHTML = `<img src="${photo.filepath}" alt="${photo.filename}" class="w-full h-full object-cover" loading="lazy">`;
                if (grid.firstChild) {
                    grid.insertBefore(thumb, grid.firstChild);
                } else {
                    grid.appendChild(thumb);
                }
            }
        });

        socket.on('camera-fertility-result', (data) => {
            if (!data || data.id === undefined || data.id === null) return;
            const photoId = Number(data.id);
            fertilityByPhotoId[photoId] = data;

            if (latestPhotoId === photoId) {
                latestFertility = data;
                renderFertilityPanel(data);
            }
            if (currentModalPhotoId === photoId) {
                renderModalFertility(data);
            }
            if (data.status === 'done') {
                const summary = data.summary || {};
                showToast(`Analisis fertilitas selesai: ${summary.fertile || 0} fertile / ${summary.total_detected || 0} telur`);
            } else if (data.status === 'failed') {
                showToast('Analisis fertilitas gagal: ' + (data.error || 'tidak diketahui'));
            }
        });

        socket.on('camera-status', (data) => {
            if (data.status === 'capturing') {
                setIncCamLoading(true, data.message || 'ESP32-S3 sedang memotret...');
            } else if (data.status === 'idle') {
                setIncCamLoading(false, data.message || 'Siap');
            }
        });

        async function triggerIncubatorCameraCapture() {
            if (isViewer) {
                showToast('Akses viewer tidak dapat mengambil foto');
                return;
            }
            if (isCamCapturing) return;

            setIncCamLoading(true, 'Mengirim perintah ambil foto ke ESP32-S3...');

            try {
                // Call API trigger to command camera via MQTT
                const res = await fetch(`/api/devices/${deviceId}/camera/capture`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'capture' })
                });
                const data = await res.json();
                if (data.success && data.published !== false) {
                    setIncCamLoading(true, 'Trigger terkirim ke ESP32-S3 Cam! Menunggu foto...');
                    setTimeout(() => {
                        if (isCamCapturing) {
                            setIncCamLoading(false, 'Kamera belum merespon. Pastikan ESP32-S3 Cam menyala & tersambung ke WiFi/MQTT.');
                        }
                    }, 15000);
                } else {
                    setIncCamLoading(false, 'Gagal: ' + (data.error || data.message || 'MQTT broker belum terhubung'));
                }
            } catch (err) {
                setIncCamLoading(false, 'Koneksi gagal: ' + err.message);
            }
        }

        async function deleteIncPhoto(photoId) {
            if (isViewer) return;
            if (!confirm('Hapus foto ini?')) return;
            try {
                const res = await fetch(`/api/devices/${deviceId}/camera/captures/${photoId}`, {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (data.success) {
                    const thumb = document.getElementById(`inc-thumb-${photoId}`);
                    if (thumb) thumb.remove();
                    delete fertilityByPhotoId[Number(photoId)];
                    if (latestPhotoId === Number(photoId)) {
                        latestPhotoId = null;
                        latestFertility = null;
                        renderFertilityPanel(null);
                    }
                    showToast('Foto berhasil dihapus');
                    // Update count
                    const countEl = document.getElementById('inc-photos-count');
                    if (countEl) {
                        let cur = parseInt(countEl.innerText) || 1;
                        countEl.innerText = Math.max(0, cur - 1) + ' Foto';
                    }
                } else {
                    alert('Gagal menghapus: ' + (data.error || 'Unknown error'));
                }
            } catch (e) {
                alert('Error hapus foto: ' + e.message);
            }
        }

        function setIncCamLoading(loading, msg) {
            isCamCapturing = loading;
            const btn = document.getElementById('btn-inc-capture');
            const iconCam = document.getElementById('inc-icon-cam');
            const iconLoading = document.getElementById('inc-icon-loading');
            const text = document.getElementById('inc-btn-capture-text');
            const msgEl = document.getElementById('inc-capture-msg');

            if (loading) {
                btn.disabled = true;
                btn.classList.add('opacity-75', 'cursor-not-allowed');
                iconCam.classList.add('hidden');
                iconLoading.classList.remove('hidden');
                text.innerText = 'Mengambil...';
                if (msgEl) msgEl.innerText = msg || 'ESP32-S3 sedang mengambil gambar...';
            } else {
                btn.disabled = false;
                btn.classList.remove('opacity-75', 'cursor-not-allowed');
                iconCam.classList.remove('hidden');
                iconLoading.classList.add('hidden');
                text.innerText = 'Ambil Foto Sekarang';
                if (msgEl) msgEl.innerText = msg || 'ESP32-S3 Cam memotret kondisi telur saat tombol ditekan dan menyimpannya di sini.';
            }
        }

        function openCamInfoModal() {
            const m = document.getElementById('cam-info-modal');
            if (m) m.classList.remove('hidden');
        }

        function closeCamInfoModal() {
            const m = document.getElementById('cam-info-modal');
            if (m) m.classList.add('hidden');
        }

        function openIncPhotoModal(src, time, id) {
            const modal = document.getElementById('inc-photo-modal');
            const img = document.getElementById('inc-modal-img');
            const timeEl = document.getElementById('inc-modal-time');
            const dl = document.getElementById('inc-modal-download');

            currentModalPhotoId = (id !== undefined && id !== null && id !== '') ? Number(id) : null;

            if (img) img.src = src;
            if (dl) dl.href = src;
            if (timeEl) timeEl.innerText = time ? new Date(time).toLocaleString('id-ID', { dateStyle: 'full', timeStyle: 'medium' }) : '';
            renderModalFertility(currentModalPhotoId !== null ? fertilityByPhotoId[currentModalPhotoId] : null);
            if (modal) modal.classList.remove('hidden');
        }

        function closeIncPhotoModal() {
            const modal = document.getElementById('inc-photo-modal');
            if (modal) modal.classList.add('hidden');
            currentModalPhotoId = null;
        }

        const servoStyle = document.createElement('style');
        servoStyle.textContent = `
            @keyframes fadeInUp {
                from { opacity: 0; transform: translate(-50%, 10px); }
                to { opacity: 1; transform: translate(-50%, 0); }
            }
        `;
        document.head.appendChild(servoStyle);
    </script>
    <%- include('../../partials/footer') %>
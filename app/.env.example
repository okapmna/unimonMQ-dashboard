# Server Configuration
PORT=8080
JWT_SECRET=unimq-jwt-secret-very-secure

# Database Configuration (matching docker-compose.yml default services)
DB_HOST=db
DB_USER=user_app
DB_PASS=password_app
DB_NAME=unimq

# Egg fertility classification runner (egg-fertility-ml)
# Kosongkan untuk menonaktifkan analisis fertilitas otomatis.
# Compose service: docker compose --profile ml up -d
FERTILITY_API_URL=http://fertility-runner:5000
# Flask di host: http://host.docker.internal:5000
FERTILITY_TIMEOUT_MS=120000
